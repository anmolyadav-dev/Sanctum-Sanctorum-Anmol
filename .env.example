# Sanctum Sanctorum Environment Variables Example

# Database connection string:
# For SQLite (default for local development & tests):
SANCTUM_DATABASE_URL=sqlite:///./sanctum.db

# For PostgreSQL (hosted deployments e.g. Supabase, Render, Neon, Railway):
# SANCTUM_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server port (optional, defaults to 8000)
PORT=8000
